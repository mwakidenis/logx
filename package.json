{
  "name": "@mwakidenis/logx",
  "version": "0.1.0",
  "description": "The Modern JavaScript Utility Engine - a modular, zero-dependency utility library for JavaScript and TypeScript",
  "author": "Mwaki Denis",
  "license": "MIT",
  "homepage": "https://github.com/mwakidenis/logx",
  "repository": {
    "type": "git",
    "url": "https://github.com/mwakidenis/logx.git"
  },
  "bugs": {
    "url": "https://github.com/mwakidenis/logx/issues"
  },
  "keywords": [
    "utilities",
    "javascript",
    "typescript",
    "logx",
    "helper",
    "array",
    "object",
    "string",
    "math",
    "date",
    "validation",
    "async"
  ],
  "engines": {
    "node": ">=20"
  },
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./array": {
      "import": {
        "types": "./dist/array/index.d.ts",
        "default": "./dist/array/index.mjs"
      },
      "require": {
        "types": "./dist/array/index.d.ts",
        "default": "./dist/array/index.js"
      }
    },
    "./object": {
      "import": {
        "types": "./dist/object/index.d.ts",
        "default": "./dist/object/index.mjs"
      },
      "require": {
        "types": "./dist/object/index.d.ts",
        "default": "./dist/object/index.js"
      }
    },
    "./string": {
      "import": {
        "types": "./dist/string/index.d.ts",
        "default": "./dist/string/index.mjs"
      },
      "require": {
        "types": "./dist/string/index.d.ts",
        "default": "./dist/string/index.js"
      }
    },
    "./number": {
      "import": {
        "types": "./dist/number/index.d.ts",
        "default": "./dist/number/index.mjs"
      },
      "require": {
        "types": "./dist/number/index.d.ts",
        "default": "./dist/number/index.js"
      }
    },
    "./math": {
      "import": {
        "types": "./dist/math/index.d.ts",
        "default": "./dist/math/index.mjs"
      },
      "require": {
        "types": "./dist/math/index.d.ts",
        "default": "./dist/math/index.js"
      }
    },
    "./function": {
      "import": {
        "types": "./dist/function/index.d.ts",
        "default": "./dist/function/index.mjs"
      },
      "require": {
        "types": "./dist/function/index.d.ts",
        "default": "./dist/function/index.js"
      }
    },
    "./collection": {
      "import": {
        "types": "./dist/collection/index.d.ts",
        "default": "./dist/collection/index.mjs"
      },
      "require": {
        "types": "./dist/collection/index.d.ts",
        "default": "./dist/collection/index.js"
      }
    },
    "./date": {
      "import": {
        "types": "./dist/date/index.d.ts",
        "default": "./dist/date/index.mjs"
      },
      "require": {
        "types": "./dist/date/index.d.ts",
        "default": "./dist/date/index.js"
      }
    },
    "./validation": {
      "import": {
        "types": "./dist/validation/index.d.ts",
        "default": "./dist/validation/index.mjs"
      },
      "require": {
        "types": "./dist/validation/index.d.ts",
        "default": "./dist/validation/index.js"
      }
    },
    "./async": {
      "import": {
        "types": "./dist/async/index.d.ts",
        "default": "./dist/async/index.mjs"
      },
      "require": {
        "types": "./dist/async/index.d.ts",
        "default": "./dist/async/index.js"
      }
    },
    "./browser": {
      "import": {
        "types": "./dist/browser/index.d.ts",
        "default": "./dist/browser/index.mjs"
      },
      "require": {
        "types": "./dist/browser/index.d.ts",
        "default": "./dist/browser/index.js"
      }
    },
    "./security": {
      "import": {
        "types": "./dist/security/index.d.ts",
        "default": "./dist/security/index.mjs"
      },
      "require": {
        "types": "./dist/security/index.d.ts",
        "default": "./dist/security/index.js"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "clean": "rm -rf dist .turbo node_modules/.cache",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint . --ext .ts,.js",
    "lint:fix": "eslint . --ext .ts,.js --fix",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\" \"*.{js,json,md,ts}\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\" \"*.{js,json,md,ts}\"",
    "docs": "typedoc",
    "benchmark": "node benchmarks/index.js",
    "pack:check": "npm pack --dry-run"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "@vitest/coverage-v8": "^4.1.12",
    "eslint": "^9.39.5",
    "prettier": "^3.9.10",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^4.1.12"
  }
}
